# Environment Configuration for AgriDOST

# 1. Google Gemini API (Server-Side Only)
# Used for AI leaf symptom analysis and crop health pathology.
# Kept strictly server-side; NEVER exposed to the browser.
# If omitted or invalid, AgriDOST falls back gracefully to its verified agronomic pre-diagnostic guides.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Maps JavaScript API (Client-Side)
# Used for live satellite imagery during boundary drawing.
# If omitted, AgriDOST automatically uses its built-in interactive vector SVG cadastre.
# 100% functional without an API key or when offline!
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. n8n Automation Engine & Webhook Gateway (AgriDOST 4.0)
# Base webhook URL of self-hosted or cloud n8n instance
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
# Shared API key for authorized webhook invocation (Bearer token)
N8N_API_KEY=agridost_n8n_api_key_secret
# Shared HMAC-SHA256 secret for request signing and replay drift protection
N8N_WEBHOOK_SECRET=agridost_hmac_webhook_signing_secret_2026

# 4. Public App URL (For n8n inbound callbacks to /api/n8n/callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Testing & Offline Emulation
# Set to 'true' to execute simulated deterministic responses without live n8n network dependency
N8N_SIMULATED_MODE=true
# Set to 'true' to allow automatic fallback to simulation if live n8n drops connection
N8N_FALLBACK_TO_SIMULATION=true

# 6. Telegram Bot API (AgriDOST 4.0 Server-Side Messaging)
# Official Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Secret token for authenticating incoming Telegram webhooks (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# Set to 'true' to run in simulated mode without live Telegram Bot API connection
TELEGRAM_SIMULATED_MODE=true
